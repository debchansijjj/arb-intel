# ============================================================
# arb-intel runtime configuration (copy to .env, fill in)
# ============================================================
# Section names map to ArbIntelSettings nested models.

ARB_INTEL_ENV=dev
ARB_INTEL_LOG_LEVEL=INFO
ARB_INTEL_LOG_JSON=true

# ---------------- storage ----------------
# DSN host = localhost when running from host (e.g. .venv/bin/arb-intel).
# Inside docker compose network use service name `postgres`; this is
# overridden via the docker-compose.yml `environment:` block automatically.
ARB_INTEL_DB__DSN=postgresql+asyncpg://arb:arb@localhost:5432/arb_intel
ARB_INTEL_DB__POOL_SIZE=20
ARB_INTEL_DB__MAX_OVERFLOW=10

ARB_INTEL_REDIS__URL=redis://localhost:6379/0
ARB_INTEL_REDIS__NAMESPACE=arb_intel

# ---------------- event bus ----------------
ARB_INTEL_BUS__BACKEND=redis_streams           # redis_streams | nats
ARB_INTEL_BUS__MAX_LEN=200000

# ---------------- chains ----------------
# JSON list of enabled chains (lower-case names).
ARB_INTEL_CHAINS__ENABLED=["solana","base","arbitrum","bsc","ethereum"]

# EVM RPCs: comma-separated WSS first, then HTTPS fallbacks.
ARB_INTEL_EVM__ETHEREUM__WSS=wss://ethereum-rpc.publicnode.com
ARB_INTEL_EVM__ETHEREUM__HTTPS=https://ethereum-rpc.publicnode.com
ARB_INTEL_EVM__BASE__WSS=wss://base-rpc.publicnode.com
ARB_INTEL_EVM__BASE__HTTPS=https://base-rpc.publicnode.com
ARB_INTEL_EVM__ARBITRUM__WSS=wss://arbitrum-one-rpc.publicnode.com
ARB_INTEL_EVM__ARBITRUM__HTTPS=https://arbitrum-one-rpc.publicnode.com
ARB_INTEL_EVM__BSC__WSS=wss://bsc-rpc.publicnode.com
ARB_INTEL_EVM__BSC__HTTPS=https://bsc-rpc.publicnode.com

# Solana
ARB_INTEL_SOLANA__RPC_HTTPS=https://api.mainnet-beta.solana.com
ARB_INTEL_SOLANA__RPC_WSS=wss://api.mainnet-beta.solana.com
ARB_INTEL_SOLANA__YELLOWSTONE_GRPC=          # e.g. https://grpc.helius-rpc.com:443
ARB_INTEL_SOLANA__YELLOWSTONE_TOKEN=
ARB_INTEL_SOLANA__HELIUS_API_KEY=

# ---------------- discovery ----------------
ARB_INTEL_DISCOVERY__DEXSCREENER_BASE=https://api.dexscreener.com/latest
ARB_INTEL_DISCOVERY__GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2
ARB_INTEL_DISCOVERY__BOOTSTRAP_INTERVAL_S=300
ARB_INTEL_DISCOVERY__MAX_TOKENS_PER_CHAIN=5000

# ---------------- arbitrage ----------------
ARB_INTEL_ARB__MIN_NET_PROFIT_USD=4.0
ARB_INTEL_ARB__MIN_SPREAD_BPS=25
ARB_INTEL_ARB__MAX_NOTIONAL_USD=2000
ARB_INTEL_ARB__SIM_SIZES_USD=[100,500,1000]
ARB_INTEL_ARB__MIN_CONFIDENCE=0.55
ARB_INTEL_ARB__CROSS_CHAIN_ENABLED=true

# ---------------- telegram ----------------
ARB_INTEL_TELEGRAM__BOT_TOKEN=
ARB_INTEL_TELEGRAM__CHAT_IDS=[]
ARB_INTEL_TELEGRAM__COOLDOWN_S=180
ARB_INTEL_TELEGRAM__MIN_CONFIDENCE=0.6
ARB_INTEL_TELEGRAM__MIN_NET_PROFIT_USD=8.0
ARB_INTEL_TELEGRAM__BLACKLIST=[]
ARB_INTEL_TELEGRAM__WATCHLIST=[]

# ---------------- api ----------------
ARB_INTEL_API__HOST=0.0.0.0
ARB_INTEL_API__PORT=8080
ARB_INTEL_API__METRICS_ENABLED=true
